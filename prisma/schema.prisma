generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String           @id
  estilo          String           @unique
  patron          String           @default("")
  caracteristicas String           @default("")
  mangaCorta      Boolean          @default(false)
  precio          Int
  dcto            Int?
  sortOrder       Int              @default(0)
  estado          String           @default("")
  hasImage        Boolean          @default(false)
  descripcion     String?
  nombre          String           @default("")
  material        String?
  variantes       ProductVariant[]

  @@map("products")
}

// Un registro por combinación (talla, color). color="" si el producto es de un solo color.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  talla     String
  color     String  @default("")
  cantidad  Int     @default(0)
  ubicacion String  @default("")

  @@unique([productId, talla, color])
  @@map("product_variants")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
}

model Order {
  id                 String      @id @default(uuid())
  reference          String      @unique
  status             OrderStatus @default(PENDING_PAYMENT)
  total              Int
  envio              Int         @default(0)
  customerName       String
  customerEmail      String
  customerPhone      String      @default("")
  customerCity       String      @default("")
  customerDepartment String      @default("")
  customerAddress    String      @default("")
  wompiTransactionId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  estilo    String
  nombre    String
  talla     String
  color     String @default("")
  precio    Int
  cantidad  Int

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_items")
}
